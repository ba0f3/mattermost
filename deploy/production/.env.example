# Copy to .env. Run docker compose from this directory.
# Pin a release tag or digest of YOUR runtime image, not the buildenv image.
# The image must contain /mattermost/bin/{mattermost,mmctl} and the built webapp.
COMPOSE_PROJECT_NAME=mattermost-production
MATTERMOST_IMAGE=
MATTERMOST_BIND_IP=127.0.0.1
MATTERMOST_HTTP_PORT=8065
MATTERMOST_MEMORY_LIMIT=4g
TZ=Asia/Ho_Chi_Minh

# Public URL served by your existing HTTPS reverse proxy.
MM_SERVICESETTINGS_SITEURL=https://chat.example.com
MM_TEAMSETTINGS_SITENAME=Mattermost

# External PostgreSQL. URL-encode special characters in username/password.
# verify-full checks both the certificate and hostname.
# For a private CA, mount its PEM as described in docker-compose.yml and append
# &sslrootcert=/mattermost/certs/postgres-ca.crt
MM_SQLSETTINGS_DATASOURCE='postgres://mattermost:CHANGE_ME@postgres.example.com:5432/mattermost?sslmode=verify-full&connect_timeout=10'
MM_SQLSETTINGS_MAXIDLECONNS=10
MM_SQLSETTINGS_MAXOPENCONNS=100
MM_SQLSETTINGS_CONNMAXLIFETIMEMILLISECONDS=3600000
MM_SQLSETTINGS_QUERYTIMEOUT=30
MM_SQLSETTINGS_MIGRATIONSSTATEMENTTIMEOUTSECONDS=100000

# External S3 or S3-compatible service; create the bucket before startup.
# Endpoint is hostname[:port], WITHOUT https:// and WITHOUT a bucket/path.
# Leave endpoint empty for AWS S3; set it for MinIO or another compatible service.
# Single-quote secrets containing $, # or spaces to prevent .env interpolation.
MM_FILESETTINGS_AMAZONS3ACCESSKEYID=
MM_FILESETTINGS_AMAZONS3SECRETACCESSKEY=
MM_FILESETTINGS_AMAZONS3BUCKET=mattermost
MM_FILESETTINGS_AMAZONS3REGION=us-east-1
MM_FILESETTINGS_AMAZONS3ENDPOINT=
MM_FILESETTINGS_AMAZONS3PATHPREFIX=
MM_FILESETTINGS_AMAZONS3SSL=true
MM_FILESETTINGS_AMAZONS3SSE=false
# Generate once with: openssl rand -hex 32. Keep stable across restarts/upgrades.
MM_FILESETTINGS_PUBLICLINKSALT=
# 100 MiB; match the reverse proxy's request body size limit.
MM_FILESETTINGS_MAXFILESIZE=104857600

# Existing SMTP service. STARTTLS normally uses 587; TLS normally uses 465.
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=true
MM_EMAILSETTINGS_REQUIREEMAILVERIFICATION=true
MM_EMAILSETTINGS_FEEDBACKNAME=Mattermost
MM_EMAILSETTINGS_FEEDBACKEMAIL=mattermost@example.com
MM_EMAILSETTINGS_REPLYTOADDRESS=mattermost@example.com
MM_EMAILSETTINGS_ENABLESMTPAUTH=true
MM_EMAILSETTINGS_SMTPUSERNAME=
MM_EMAILSETTINGS_SMTPPASSWORD=
MM_EMAILSETTINGS_SMTPSERVER=smtp.example.com
MM_EMAILSETTINGS_SMTPPORT=587
MM_EMAILSETTINGS_CONNECTIONSECURITY=STARTTLS

# Invitations are required by default. First account can be created via mmctl.
MM_TEAMSETTINGS_ENABLEOPENSERVER=false
MM_TEAMSETTINGS_ENABLEUSERCREATION=true
MM_EMAILSETTINGS_ENABLESIGNUPWITHEMAIL=true
MM_EMAILSETTINGS_ENABLESIGNINWITHEMAIL=true
MM_EMAILSETTINGS_ENABLESIGNINWITHUSERNAME=true

# Native OIDC only: requires an image containing the Enterprise OIDC provider
# and an appropriate license. For mattermost-oidc, configure the plugin instead.
MM_OPENIDSETTINGS_ENABLE=false
MM_OPENIDSETTINGS_ID=mattermost
MM_OPENIDSETTINGS_SECRET=
MM_OPENIDSETTINGS_DISCOVERYENDPOINT=https://sso.example.com/realms/company/.well-known/openid-configuration
MM_OPENIDSETTINGS_SCOPE=openid profile email
MM_OPENIDSETTINGS_BUTTONTEXT=Keycloak
MM_OPENIDSETTINGS_USEPREFERREDUSERNAME=true

# Install plugins in the runtime image, or temporarily enable uploads via Console.
MM_PLUGINSETTINGS_ENABLEUPLOADS=false
MM_LOGSETTINGS_CONSOLELEVEL=INFO
# Enable only after choosing a push service for the mobile app.
MM_EMAILSETTINGS_SENDPUSHNOTIFICATIONS=false
MM_EMAILSETTINGS_PUSHNOTIFICATIONSERVER=
