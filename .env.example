# Mattermost local dev configuration.
#
# Copy this file to .env and fill in the secrets. The root Makefile sources
# .env with `set -a`, so every value here reaches the server and sub-Makefiles.
# .env is gitignored; never commit real credentials.

# --- Server -----------------------------------------------------------------
MM_SERVICESETTINGS_SITEURL=http://localhost:8065
MM_SERVICESETTINGS_ENABLELOCALMODE=true
MM_SERVICESETTINGS_LOCALMODESOCKETLOCATION=/var/tmp/mattermost_local.socket
MM_LOGSETTINGS_CONSOLELEVEL=DEBUG

# --- Database (postgres container started by `make deps`) -------------------
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE="postgres://mmuser:mostest_password@localhost:5432/mattermost_test?sslmode=disable&connect_timeout=10"

# --- Docker services (server/Makefile) --------------------------------------
ENABLED_DOCKER_SERVICES="postgres inbucket redis"
# Use the pgvector postgres image; the Agents plugin uses it for semantic search.
MM_USE_PGVECTOR=true

# --- Plugins ----------------------------------------------------------------
MM_PLUGINSETTINGS_DIRECTORY=./plugins
MM_PLUGINSETTINGS_CLIENTDIRECTORY=./client/plugins
MM_PLUGINSETTINGS_ENABLEUPLOADS=true

# --- Local admin (created by `make admin`) ----------------------------------
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=Mattermost123!

# --- OIDC (external provider) ------------------------------------------------
# Register these redirect URIs with the provider:
#   http://localhost:8065/signup/openid/complete
#   http://localhost:8065/login/openid/complete
MM_OPENIDSETTINGS_ENABLE=true
MM_OPENIDSETTINGS_ID=
MM_OPENIDSETTINGS_SECRET=
MM_OPENIDSETTINGS_SCOPE="openid profile email"
MM_OPENIDSETTINGS_DISCOVERYENDPOINT=
MM_OPENIDSETTINGS_BUTTONTEXT="Login with SSO"
MM_OPENIDSETTINGS_BUTTONCOLOR="#1e325c"

# --- Agents plugin: OpenAI-compatible LLM service ---------------------------
# Values used to seed the plugin's LLM service; the API key is never committed.
DEV_LLM_BASE_URL=
DEV_LLM_MODEL=
DEV_LLM_API_KEY=
